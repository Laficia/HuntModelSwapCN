[
  {
    "NameId": 13437,
    "Name": "天气预报机器人",
    "ModelId": 4199,
    "WikiUrl": "https://ff14.huijiwiki.com/wiki/%E5%A4%A9%E6%B0%94%E9%A2%84%E6%8A%A5%E6%9C%BA%E5%99%A8%E4%BA%BA",
    "Rows": [
      {
        "RowId": 16982,
        "ExpectedText": "哔——错误……重启……\n今天也为您播报天气……"
      },
      {
        "RowId": 16983,
        "ExpectedText": "读取气象数据……\n愉快的天气预报时间！"
      },
      {
        "RowId": 16984,
        "ExpectedText": "气象速报……灿烂暖洋洋，心中热腾腾……\n热浪即将袭来！"
      },
      {
        "RowId": 16985,
        "ExpectedText": "气象速报……轰隆雷鸣，皮肤麻麻的……\n雷波即将袭来！"
      },
      {
        "RowId": 16986,
        "ExpectedText": "气象速报……唰唰强风，窗户哗啦响……\n暴风即将袭来！"
      },
      {
        "RowId": 16987,
        "ExpectedText": "气象速报……鹅毛大雪，狗狗兴冲冲……\n暴雪即将袭来！"
      },
      {
        "RowId": 16988,
        "ExpectedText": "气象速报……啪啦啪啦降雨，雨伞吧嗒吧嗒……\n大雨即将袭来！"
      },
      {
        "RowId": 16989,
        "ExpectedText": "叮咚铛咚，叮咚咚！\n为您提供最新的天气预报！"
      },
      {
        "RowId": 16990,
        "ExpectedText": "重新读取气象数据……\n热浪过后会有雷波、暴雪！"
      },
      {
        "RowId": 16991,
        "ExpectedText": "重新读取气象数据……\n雷波过后会有暴风、热浪！"
      },
      {
        "RowId": 16992,
        "ExpectedText": "重新读取气象数据……\n暴雪过后会有雷波、暴风！"
      },
      {
        "RowId": 16993,
        "ExpectedText": "重新读取气象数据……\n暴风过后会有热浪、雷波！"
      },
      {
        "RowId": 16994,
        "ExpectedText": "叮咚咣当，嘭嘭！\n再现预报的气象！"
      }
    ]
  },
